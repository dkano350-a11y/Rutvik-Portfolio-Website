# Gemini API Configuration
# Get your key from https://aistudio.google.com/
GEMINI_API_KEY=

# Base URL Configuration
APP_URL=

# App Admin Setup (Optional custom admin password instead of default)
VITE_APP_ADMIN_PASSWORD=

# Email SMTP Notification Config (Optional)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
NOTIFICATION_EMAIL=

# Twilio Configuration (WhatsApp Webhook and optional REST API)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
TWILIO_TARGET_NUMBER=
