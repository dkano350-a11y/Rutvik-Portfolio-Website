rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    match /messages/{messageId} {
      allow read, write: if true;
    }

    match /project_images/{projectId} {
      allow read, write: if true;
    }

    match /stats/{id} {
      allow read, write: if true;
    }

    match /photo_views/{viewId} {
      allow read, write: if true;
    }

    match /settings/{id} {
      allow read, write: if true;
    }

    match /newsletter/{id} {
      allow read, write: if true;
    }

    match /attachments/{id} {
      allow read, write: if true;
    }

    match /whatsapp_history/{id} {
      allow read, write: if true;
    }

    match /blogs/{id} {
      allow read, write: if true;
    }

    match /models3d/{id} {
      allow read, write: if true;
    }

    match /mailbox_records/{id} {
      allow read, write: if true;
    }

    match /user_settings/{visitorId} {
      allow read, write: if true;
    }

    match /email_logs/{id} {
      allow read, write: if true;
    }

    match /twilio_logs/{id} {
      allow read, write: if true;
    }
    match /system_errors/{id} {
      allow read, write: if true;
    }
  }
}
